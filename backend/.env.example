DATABASE_URL=postgresql://eduapp:eduapp_password@localhost:5432/eduapp
REDIS_URL=redis://localhost:6379/0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ENVIRONMENT=development
CORS_ORIGINS=["*"]

# Google Sign-In: OAuth client IDs (Android, iOS, Web) as a JSON list
GOOGLE_CLIENT_IDS=[]

LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
TIMEZONE=Asia/Dushanbe

# Superadmin for the /admin panel, created by `python -m app.seed`
FIRST_SUPERADMIN_EMAIL=admin@eduapp.tj
FIRST_SUPERADMIN_PASSWORD=change-me
